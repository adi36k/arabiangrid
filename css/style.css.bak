/* ========== VARIABLES ========== */
:root {
    --navy: #1E3A5F;
    --gold: #B8963E;
    --charcoal: #333333;
    --gray: #666666;
    --light-gray: #999999;
    --cream: #F5F3EF;
    --white: #FFFFFF;
    --border-light: #E5E5E5;
    --font-primary: 'Arial', 'Helvetica Neue', sans-serif;
    --transition: all 0.3s ease;
}

/* ========== RESET ========== */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: var(--font-primary);
    color: var(--charcoal);
    background: var(--white);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ========== CONTAINER ========== */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
}

/* ========== NAVIGATION ========== */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-light);
}

.nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
}

.logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--navy);
    color: var(--gold);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.5px;
}

.logo-text {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--navy);
    text-transform: uppercase;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 32px;
}

.nav-links a {
    text-decoration: none;
    color: var(--gray);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
    transition: var(--transition);
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--navy);
    border-bottom-color: var(--gold);
}

.nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
}

.nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--navy);
    transition: var(--transition);
}

/* ========== HERO ========== */
.hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--navy);
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(30,58,95,0.95) 0%, rgba(30,58,95,0.85) 50%, rgba(30,58,95,0.75) 100%);
    z-index: 1;
}

.hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(184,150,62,0.08)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
    z-index: 2;
}

.hero-content {
    position: relative;
    z-index: 3;
    max-width: 800px;
    padding-top: 100px;
}

.hero-label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 24px;
}

.hero h1 {
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 700;
    color: var(--white);
    line-height: 1.15;
    margin-bottom: 24px;
    letter-spacing: -0.5px;
}

.hero-sub {
    font-size: clamp(16px, 2vw, 20px);
    color: rgba(255,255,255,0.75);
    line-height: 1.6;
    max-width: 640px;
    margin-bottom: 40px;
}

.hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}

.hero-scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.hero-scroll span {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
}

.scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--gold), transparent);
}

/* ========== BUTTONS ========== */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    text-transform: uppercase;
}

.btn-primary {
    background: var(--gold);
    color: var(--navy);
}

.btn-primary:hover {
    background: #a88430;
    transform: translateY(-2px);
}

.btn-ghost {
    background: transparent;
    color: var(--white);
    border: 1.5px solid rgba(255,255,255,0.4);
}

.btn-ghost:hover {
    border-color: var(--gold);
    color: var(--gold);
}

/* ========== SECTIONS ========== */
.section {
    padding: 80px 0;
}

.section-header {
    margin-bottom: 48px;
}

.section-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
}

.section-header h2 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--navy);
    letter-spacing: -0.3px;
}

/* ========== KPI SECTION ========== */
.kpi-section {
    background: var(--cream);
    padding: 60px 0;
}

.kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
}

.kpi-card {
    text-align: center;
    padding: 32px 16px;
    background: var(--white);
    border: 1px solid var(--border-light);
    position: relative;
}

.kpi-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gold);
}

.kpi-number {
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 700;
    color: var(--navy);
    line-height: 1;
    margin-bottom: 8px;
    font-family: Georgia, 'Times New Roman', serif;
}

.kpi-unit {
    font-size: 20px;
    color: var(--gold);
    margin-left: 4px;
}

.kpi-label {
    font-size: 13px;
    color: var(--gray);
    letter-spacing: 0.3px;
}

/* ========== BRIEF CARDS ========== */
.featured-section {
    background: var(--white);
}

.brief-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.brief-card {
    background: var(--white);
    border: 1px solid var(--border-light);
    padding: 32px;
    display: flex;
    flex-direction: column;
    transition: var(--transition);
    position: relative;
}

.brief-card:hover {
    border-color: var(--gold);
    box-shadow: 0 8px 32px rgba(0,0,0,0.06);
}

.brief-featured {
    grid-column: span 2;
    background: var(--navy);
    color: var(--white);
    border: none;
}

.brief-featured .brief-title {
    color: var(--white);
}

.brief-featured .brief-excerpt {
    color: rgba(255,255,255,0.75);
}

.brief-featured:hover {
    box-shadow: 0 12px 40px rgba(30,58,95,0.25);
}

.brief-meta {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
    align-items: center;
}

.brief-country {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gold);
}

.brief-date {
    font-size: 12px;
    color: var(--light-gray);
}

.brief-featured .brief-date {
    color: rgba(255,255,255,0.5);
}

.brief-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: 12px;
}

.brief-excerpt {
    font-size: 15px;
    color: var(--gray);
    line-height: 1.6;
    margin-bottom: 20px;
    flex-grow: 1;
}

.brief-stats {
    display: flex;
    gap: 20px;
    margin-bottom: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    font-size: 13px;
    color: var(--gray);
}

.brief-featured .brief-stats {
    border-color: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.7);
}

.brief-stats strong {
    color: var(--navy);
    font-weight: 700;
}

.brief-featured .brief-stats strong {
    color: var(--gold);
}

.brief-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.tag {
    display: inline-block;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    background: var(--cream);
    color: var(--gray);
    border: 1px solid var(--border-light);
}

.brief-featured .tag {
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.8);
    border-color: rgba(255,255,255,0.2);
}

.brief-link {
    display: inline-block;
    font-size: 14px;
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
    transition: var(--transition);
}

.brief-link:hover {
    color: var(--gold);
}

.brief-featured .brief-link {
    color: var(--gold);
}

.brief-featured .brief-link:hover {
    color: var(--white);
}

.brief-link.disabled {
    color: var(--light-gray);
    cursor: default;
    pointer-events: none;
}

/* ========== CTA SECTION ========== */
.cta-section {
    background: var(--cream);
}

.cta-box {
    background: var(--white);
    border: 1px solid var(--border-light);
    padding: 48px;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    position: relative;
}

.cta-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gold);
}

.cta-box h2 {
    font-size: 24px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 12px;
}

.cta-box p {
    font-size: 15px;
    color: var(--gray);
    margin-bottom: 28px;
}

.subscribe-form {
    display: flex;
    gap: 12px;
    max-width: 440px;
    margin: 0 auto 12px;
}

.subscribe-form input {
    flex: 1;
    padding: 14px 16px;
    font-size: 14px;
    border: 1px solid var(--border-light);
    background: var(--cream);
    color: var(--charcoal);
    outline: none;
    transition: var(--transition);
}

.subscribe-form input:focus {
    border-color: var(--gold);
}

.subscribe-form input::placeholder {
    color: var(--light-gray);
}

.form-note {
    font-size: 12px;
    color: var(--light-gray);
    font-style: italic;
}

/* ========== ABOUT TEASER ========== */
.about-teaser {
    background: var(--white);
}

.teaser-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 64px;
    align-items: start;
}

.image-placeholder {
    width: 100%;
    aspect-ratio: 3/4;
    background: var(--cream);
    border: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: var(--light-gray);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.teaser-text h2 {
    font-size: 28px;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.25;
    margin-bottom: 20px;
}

.teaser-text p {
    font-size: 16px;
    color: var(--gray);
    line-height: 1.7;
    margin-bottom: 16px;
}

/* ========== PAGE HEADER ========== */
.page-header {
    background: var(--navy);
    padding: 140px 0 60px;
    position: relative;
}

.page-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(184,150,62,0.08)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
    opacity: 0.5;
}

.page-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
    position: relative;
}

.page-header h1 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: var(--white);
    line-height: 1.2;
    max-width: 700px;
    position: relative;
}

.page-intro {
    font-size: 16px;
    color: rgba(255,255,255,0.7);
    max-width: 640px;
    margin-top: 16px;
    position: relative;
    line-height: 1.6;
}

/* ========== FILTER BAR ========== */
.filter-section {
    padding: 24px 0;
    background: var(--cream);
    border-bottom: 1px solid var(--border-light);
}

.filter-bar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.filter-btn {
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.3px;
    background: var(--white);
    border: 1px solid var(--border-light);
    color: var(--gray);
    cursor: pointer;
    transition: var(--transition);
    text-transform: uppercase;
}

.filter-btn:hover,
.filter-btn.active {
    background: var(--navy);
    color: var(--white);
    border-color: var(--navy);
}

/* ========== LIBRARY SECTION ========== */
.library-section {
    padding: 48px 0 80px;
    background: var(--white);
}

.library-section .brief-grid {
    grid-template-columns: repeat(2, 1fr);
}

.library-section .brief-card {
    padding: 28px;
}

/* ========== METHODOLOGY ========== */
.methodology-section {
    background: var(--cream);
}

.method-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
}

.method-card {
    background: var(--white);
    border: 1px solid var(--border-light);
    padding: 32px;
    position: relative;
}

.method-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: var(--gold);
}

.method-number {
    font-size: 36px;
    font-weight: 700;
    color: var(--gold);
    opacity: 0.4;
    margin-bottom: 16px;
    font-family: Georgia, serif;
}

.method-card h4 {
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 12px;
}

.method-card p {
    font-size: 14px;
    color: var(--gray);
    line-height: 1.7;
}

/* ========== ABOUT PAGE ========== */
.about-section {
    padding: 60px 0 80px;
}

.about-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 64px;
    align-items: start;
}

.about-image .image-placeholder {
    aspect-ratio: 1;
    margin-bottom: 24px;
}

.about-contact-card {
    background: var(--cream);
    border: 1px solid var(--border-light);
    padding: 24px;
}

.contact-item {
    display: flex;
    flex-direction: column;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-light);
}

.contact-item:last-of-type {
    border-bottom: none;
    margin-bottom: 20px;
}

.contact-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--light-gray);
    margin-bottom: 4px;
}

.contact-value {
    font-size: 14px;
    font-weight: 500;
    color: var(--charcoal);
}

.btn-full {
    width: 100%;
}

.about-content h3 {
    font-size: 22px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 16px;
    margin-top: 40px;
}

.about-content h3:first-child {
    margin-top: 0;
}

.about-content p {
    font-size: 16px;
    color: var(--gray);
    line-height: 1.7;
    margin-bottom: 16px;
}

.credential-list {
    list-style: none;
    padding: 0;
}

.credential-list li {
    padding: 12px 0;
    border-bottom: 1px solid var(--border-light);
    font-size: 15px;
    color: var(--gray);
    line-height: 1.5;
}

.credential-list li:last-child {
    border-bottom: none;
}

.credential-list strong {
    color: var(--navy);
    font-weight: 600;
}

/* ========== TIMELINE ========== */
.timeline-section {
    background: var(--cream);
}

.timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 120px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--gold);
    opacity: 0.3;
}

.timeline-item {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 40px;
    margin-bottom: 40px;
    position: relative;
}

.timeline-item::before {
    content: '';
    position: absolute;
    left: 114px;
    top: 6px;
    width: 12px;
    height: 12px;
    background: var(--gold);
    border: 3px solid var(--cream);
    border-radius: 50%;
}

.timeline-year {
    font-size: 14px;
    font-weight: 700;
    color: var(--gold);
    text-align: right;
    padding-top: 2px;
}

.timeline-content h4 {
    font-size: 18px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 8px;
}

.timeline-content p {
    font-size: 14px;
    color: var(--gray);
    line-height: 1.6;
}

/* ========== CONTACT PAGE ========== */
.contact-section {
    padding: 60px 0 80px;
    background: var(--white);
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
}

.contact-info h3,
.contact-form-wrapper h3 {
    font-size: 22px;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 28px;
}

.contact-method {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-light);
}

.contact-icon {
    font-size: 24px;
    line-height: 1;
}

.contact-detail {
    display: flex;
    flex-direction: column;
}

.contact-detail .contact-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--light-gray);
    margin-bottom: 4px;
}

.contact-detail .contact-value {
    font-size: 15px;
    font-weight: 500;
    color: var(--charcoal);
    text-decoration: none;
    transition: var(--transition);
}

.contact-detail .contact-value:hover {
    color: var(--gold);
}

.contact-note {
    margin-top: 24px;
    padding: 20px;
    background: var(--cream);
    border-left: 3px solid var(--gold);
}

.contact-note p {
    font-size: 14px;
    color: var(--gray);
    line-height: 1.6;
    margin: 0;
}

/* Form */
.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: 8px;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 14px 16px;
    font-size: 14px;
    border: 1px solid var(--border-light);
    background: var(--cream);
    color: var(--charcoal);
    outline: none;
    transition: var(--transition);
    font-family: var(--font-primary);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    border-color: var(--gold);
}

.form-group textarea {
    resize: vertical;
    min-height: 120px;
}

/* ========== AVAILABILITY ========== */
.availability-section {
    padding: 0 0 80px;
    background: var(--white);
}

.availability-card {
    background: var(--navy);
    padding: 40px;
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
}

.availability-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
}

.status-dot {
    width: 10px;
    height: 10px;
    background: #4CAF50;
    border-radius: 50%;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.status-text {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gold);
}

.availability-card p {
    font-size: 16px;
    color: rgba(255,255,255,0.8);
    line-height: 1.7;
    margin-bottom: 24px;
}

.availability-tags {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
}

.availability-tags .tag {
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.9);
    border-color: rgba(255,255,255,0.2);
}

/* ========== FOOTER ========== */
.footer {
    background: var(--navy);
    padding: 60px 0 24px;
    color: var(--white);
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 40px;
}

.footer-brand .logo-mark {
    background: var(--gold);
    color: var(--navy);
}

.footer-brand .logo-text {
    color: var(--white);
}

.footer-tagline {
    margin-top: 16px;
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    line-height: 1.5;
}

.footer-links h4 {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 20px;
}

.footer-links ul {
    list-style: none;
}

.footer-links li {
    margin-bottom: 12px;
}

.footer-links a {
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: var(--transition);
}

.footer-links a:hover {
    color: var(--gold);
}

.footer-bottom {
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.1);
    text-align: center;
}

.footer-bottom p {
    font-size: 13px;
    color: rgba(255,255,255,0.4);
    margin-bottom: 4px;
}

/* ========== RESPONSIVE ========== */
@media (max-width: 1024px) {
    .brief-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .brief-featured {
        grid-column: span 2;
    }
    
    .about-grid {
        grid-template-columns: 280px 1fr;
        gap: 40px;
    }
}

@media (max-width: 768px) {
    .nav-links {
        display: none;
        position: absolute;
        top: 64px;
        left: 0;
        right: 0;
        background: var(--white);
        flex-direction: column;
        padding: 24px;
        border-bottom: 1px solid var(--border-light);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }
    
    .nav-links.active {
        display: flex;
    }
    
    .nav-toggle {
        display: flex;
    }
    
    .hero-content {
        padding-top: 80px;
    }
    
    .kpi-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .brief-grid {
        grid-template-columns: 1fr;
    }
    
    .brief-featured {
        grid-column: span 1;
    }
    
    .teaser-grid {
        grid-template-columns: 1fr;
        gap: 32px;
    }
    
    .teaser-image {
        max-width: 280px;
    }
    
    .library-section .brief-grid {
        grid-template-columns: 1fr;
    }
    
    .method-grid {
        grid-template-columns: 1fr;
    }
    
    .about-grid {
        grid-template-columns: 1fr;
    }
    
    .about-image {
        max-width: 300px;
        margin: 0 auto;
    }
    
    .timeline::before {
        left: 20px;
    }
    
    .timeline-item {
        grid-template-columns: 1fr;
        gap: 12px;
        padding-left: 48px;
    }
    
    .timeline-item::before {
        left: 14px;
    }
    
    .timeline-year {
        text-align: left;
    }
    
    .contact-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }
    
    .footer-grid {
        grid-template-columns: 1fr;
        gap: 32px;
    }
    
    .subscribe-form {
        flex-direction: column;
    }
}

@media (max-width: 480px) {
    .kpi-grid {
        grid-template-columns: 1fr;
    }
    
    .section {
        padding: 60px 0;
    }
    
    .cta-box {
        padding: 32px 24px;
    }
    
    .availability-card {
        padding: 28px 20px;
    }
}
